# Copy this file to .env and set values for your local machine.
MM1_APP_PORT=8080
MM1_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
# Initial password for the separate, per-module administrator accounts.
MM1_MODULE_ADMIN_PASSWORD=replace-with-a-strong-module-admin-password
MM1_COOKIE_SECURE=0
MM1_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MM1_DB_HOST=127.0.0.1
MM1_DB_PORT=3306
MM1_DB_NAME=mm1_microfinance
MM1_DB_USER=mm1_app
MM1_DB_PASSWORD=replace-with-a-local-app-password
MM1_MYSQL_ROOT_PASSWORD=replace-with-your-local-mysql-root-password
